# Client: Vite API endpoint; leave empty for local dev proxy
VITE_API_URL=
# Optional contract on Hadrian; deploy and set after testing
VITE_REGISTRY_ADDRESS=
VITE_HADRIAN_RPC=https://hadrian.testnet.romeprotocol.xyz/
VITE_HADRIAN_CHAIN_ID=200010
# Server: domain used for signing challenges; set to your deployed domain
APP_ORIGIN=http://localhost:5173
PORT=8787
# Required in production: set to a long random string
SESSION_SECRET=replace-this-in-production
# Optional, only for trusted server-side anchoring; NEVER put private keys in VITE_ variables
# ANCHOR_PRIVATE_KEY=
# ANCHOR_RPC_URL=
# ANCHOR_CONTRACT_ADDRESS=

# Hadrian on-chain attestation (optional)
HADRIAN_RPC=https://hadrian.testnet.romeprotocol.xyz/
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
